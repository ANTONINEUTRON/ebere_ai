# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ebere?retryWrites=true&w=majority

# ─── Redis (BullMQ) ───────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<Password>
REDIS_TLS=true

# ─── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=your-random-secret-min-32-chars

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# ─── File & Skill Storage (GCS — required in production) ─────────────────────
GCS_BUCKET=                            # GCS bucket name
GCS_PROJECT_ID=                        # Google Cloud project ID
GOOGLE_APPLICATION_CREDENTIALS=       # Path to service account JSON; leave blank for Workload Identity
# Local dev: provider falls back to ./uploads when GCS_BUCKET is unset

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_POSTS_PER_HOUR=10
RATE_LIMIT_SKILL_FETCHES_PER_MIN=30

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM="Ebere" <no-reply@ebere.app>

# ─── Billing ──────────────────────────────────────────────────────────────────
FREE_MESSAGE_LIMIT=50
PRO_PRICE_MONTHLY=2000
PRO_CURRENCY=NGN
